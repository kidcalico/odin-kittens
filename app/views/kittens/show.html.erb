<h1><%= @kitten.name %></h1>

<ul>
  <li>Name: <%= @kitten.name %></li>
  <li>Age: <%= @kitten.age %></li>
  <li>Cuteness: <%= @kitten.cuteness %></li>
  <li>Softness: <%= @kitten.softness %></li>
</ul>

<div>
  <%= link_to "Edit #{@kitten.name}", edit_kitten_path %>
</div>
<div>
  <%= link_to "Kittens Index", kittens_path %>
</div>
<div>
  <%= link_to "Delete #{@kitten.name}", @kitten, data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete #{@kitten.name}?" } %>
</div>